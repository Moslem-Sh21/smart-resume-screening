# Application
APP_NAME=Smart Resume Screening
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Local storage
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts
UPLOAD_DIR=./data/uploads

# Document parsing
PARSER_PROVIDER=docling
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,docx

# Embedding and retrieval
EMBEDDING_PROVIDER=bge
EMBEDDING_MODEL=BAAI/bge-m3
VECTOR_STORE=local
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# Explanation model
MLLM_PROVIDER=placeholder
MLLM_MODEL=placeholder
MLLM_API_KEY=

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_screening

# AWS
AWS_REGION=ca-central-1
AWS_S3_BUCKET=
AWS_ECR_REPOSITORY=
AWS_OPENSEARCH_ENDPOINT=
AWS_TEXTRACT_ENABLED=false

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000