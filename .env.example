# Application
APP_NAME=Visual Product RAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO

# Local data and artifacts
DATA_DIR=./data
ARTIFACTS_DIR=./artifacts

# Embedding configuration
EMBEDDING_PROVIDER=clip
EMBEDDING_MODEL=openai/clip-vit-base-patch32

# Vector store
VECTOR_STORE=faiss
FAISS_INDEX_PATH=./artifacts/product_index.faiss

# Multimodal language model
MLLM_PROVIDER=placeholder
MLLM_MODEL=placeholder
MLLM_API_KEY=

# AWS configuration
AWS_REGION=ca-central-1
AWS_S3_BUCKET=
AWS_ECR_REPOSITORY=
AWS_OPENSEARCH_ENDPOINT=

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
